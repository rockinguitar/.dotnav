[alias]
	st = status -sb
	ll = log --pretty=format:\"%C(yellow)%h%Creset %C(cyan)%ad%Creset %s\" --date=format:\"%Y-%m-%d %H:%M\"
	lg = log --graph --decorate --oneline --all
	last = log -1 HEAD --stat

	sw = switch
	c = checkout
	cob = switch -c

	cm = commit -m
	ca = commit --amend
	cane = commit --amend --no-edit
	ac = commit -am

	p = push
	po = push -u origin HEAD
	pf = push --force-with-lease

	f = fetch --prune
	rv = remote -v
	ba = branch -a

	d = diff
	dc = diff --cached

	unstage = restore --staged
	rb = rebase -i --autosquash
	cp = cherry-pick

	gl = config --global -l
