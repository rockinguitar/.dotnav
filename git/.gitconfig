[include]
path = ~/.gitconfig_work

[core]
	editor = code --wait
	autocrlf = input
	pager = delta

[init]
	defaultBranch = main

[include]
path = ~/.gitconfig_aliases
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
[merge]
	conflictstyle = zdiff3
